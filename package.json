{
  "name": "dsh-roco-daily",
  "version": "0.1.0",
  "description": "《洛克王国：世界》日常自动化 · 与 DSH 桌宠联动。运行时零 LLM 调用（纯脚本），DSH 启动即生效。",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "desktop-pet", "roco-kingdom", "game-automation"],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": ["index.js", "lib", "tools", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "probe": "node tools/cli.mjs probe",
    "calibrate": "node tools/cli.mjs calibrate",
    "run": "node tools/cli.mjs run"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
